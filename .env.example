# Beispiel-Konfiguration für das ExpressBlog-Projekt
# Kopiere diese Datei zu '.env' und passe die Werte an

# ===========================================
# UMGEBUNG & SERVER
# ===========================================
NODE_ENV=development
PORT=3000
HTTPS_PORT=3443
HOST=0.0.0.0
DOMAIN=localhost

# ===========================================
# LOGGING
# ===========================================
# Verfügbare Log-Level: ERROR, WARN, INFO, DEBUG
LOG_LEVEL=INFO
# Optional: expliziter Datei-Logpfad (im Container z.B. /app/logs)
# LOG_DIR=/app/logs

# ===========================================
# DATENBANK (MariaDB)
# ===========================================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name

# ===========================================
# SICHERHEIT
# ===========================================
JWT_SECRET=your_jwt_secret_here

# ===========================================
# EXTERNE APIS
# ===========================================
GEMINI_API_KEY=your_gemini_api_key_here
TINY_MCE_API_KEY=your_tiny_mce_api_key_here
# Optional und kostenpflichtig: Wenn gesetzt, wird Claude vor Gemini verwendet
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ===========================================
# E-MAIL (Kontaktformular & Kommentar-Benachrichtigung)
# ===========================================
# Standard ist ein Mail-Relay auf dem Docker-Host
SMTP_HOST=host.docker.internal
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# TLS-Zertifikat des SMTP-Servers prüfen. Standard: true für alle Hosts außer
# einem lokalen Relay (host.docker.internal, localhost, 127.0.0.0/8, ::1), weil
# für diese Namen kein gültiges Zertifikat existiert. Wird der lokale MTA über die
# eigene öffentliche IP des Servers angesprochen, muss hier explizit false stehen.
# SMTP_TLS_REJECT_UNAUTHORIZED=true
# Name, mit dem sich der Mail-Client beim SMTP-Server meldet (EHLO/HELO). Standard: mail.<DOMAIN>.
# Sollte der MX-/PTR-Name des Servers sein; der Container-Hostname ist kein FQDN und wird
# vom Spamfilter als fehlerhafter HELO gewertet.
# SMTP_CLIENT_NAME=mail.example.com
# Empfänger des Kontaktformulars (genau eine Adresse). Die Kontaktmail wird ebenfalls von dieser
# Adresse gesendet (From = To), die Adresse des Besuchers steht im Reply-To.
CONTACT_FORM_TO=you@example.com
# Absender der Kommentar-Benachrichtigungen (nicht der Kontaktmails)
# CONTACT_FORM_FROM=no-reply@example.com
# COMMENT_NOTIFY_TO=you@example.com

# ===========================================
# DESIGN / THEME
# ===========================================
# BLOG_THEME:    soft (Standard) | radical (das bisherige dunkle Design)
# BLOG_BACKDROP: nur für "soft" - herbst (Standard, Allee) | herbst-himmel | herbst-wald | herbst-baeume
#                | winter | nebel | fruehling | sommer
# Ungültige Werte fallen auf den Standard zurück (Warnung im Log beim Start).
# BLOG_THEME=soft
# BLOG_BACKDROP=herbst

# ===========================================
# CACHE (In-Memory / simpleCache)
# ===========================================
# Standard: Posts werden standardmäßig für 3600000 ms (1 Stunde) gecached.
# - POSTS_CACHE_TTL_MS: TTL in Millisekunden für Cache-Einträge (0 = deaktiviert)
# - POSTS_CACHE_MAX_ENTRIES: Maximale Anzahl von Einträgen im Cache (0 = keine Beschränkung)
# - POSTS_CACHE_MAX_BYTES: Maximale geschätzte Gesamtgröße des Caches in Bytes (0 = deaktiviert)
# Beispielwerte (anpassen nach Bedarf):
POSTS_CACHE_TTL_MS=3600000
POSTS_CACHE_MAX_ENTRIES=200
POSTS_CACHE_MAX_BYTES=104857600

# ===========================================
# RATE LIMITING
# ===========================================
# Kommaseparierte Liste von IPs oder CIDR-Ranges, die vom Rate-Limiting
# ausgenommen sind (z.B. eigenes Provider-Subnet). Nicht in Produktion verwenden!
# RATE_LIMIT_WHITELIST=84.115.0.0/16,10.0.0.0/8

# ===========================================
# PRODUKTIONS-SPEZIFISCH
# ===========================================
# PLESK_ENV=true  # Nur für Plesk-Hosting
