<% 
    pageTitle = 'Sub specie aeternitatis';
    metaDescription = 'Tech, Programming, Philosophy, Science, News and more';
%>

<% const __soft = typeof theme !== 'undefined' && theme && theme.id === 'soft'; %>
<% if (__soft) { %>
<div class="header-section header-section--soft">
    <%- include('partials/homeHero') %>

    <% if (typeof leadPost !== 'undefined' && leadPost) { %>
    <article class="lead-post<%= leadPost.previewImage && leadPost.previewImage.src ? ' lead-post--image' : '' %>">
        <% if (leadPost.previewImage && leadPost.previewImage.src) { %>
        <img class="lead-post-image" src="<%= leadPost.previewImage.src %>"<% if (leadPost.previewImage.srcset) { %> srcset="<%= leadPost.previewImage.srcset %>" sizes="(max-width: 860px) 100vw, 480px"<% } %> alt="" decoding="async">
        <% } %>
        <div class="lead-post-body">
            <p class="lead-post-label">Aktuell</p>
            <h2 class="lead-post-title"<% if (leadPost.lang && leadPost.lang !== 'de') { %> lang="<%= leadPost.lang %>"<% } %>><a class="lead-post-link" href="/blogpost/<%= leadPost.slug %>"><%= leadPost.title %></a></h2>
            <% if (leadPost.excerpt) { %><p class="lead-post-excerpt"<% if (leadPost.lang && leadPost.lang !== 'de') { %> lang="<%= leadPost.lang %>"<% } %>><%= leadPost.excerpt %></p><% } %>
            <p class="lead-post-meta">
                <% if (leadPost.created_at) { %><time datetime="<%= new Date(leadPost.created_at).toISOString() %>"><%= new Date(leadPost.created_at).toLocaleDateString('de-DE', { day: 'numeric', month: 'long', year: 'numeric' }) %></time><span class="lead-post-sep" aria-hidden="true">·</span><% } %>
                <span class="lead-post-cta">Weiterlesen <span aria-hidden="true">→</span></span>
            </p>
        </div>
    </article>
    <% } %>

    <%
        // Everything above is already shown: the next two posts follow the lead, and the
        // sidebar's "Beliebte Beiträge" only lists posts that are not on this screen yet.
        const __more = (typeof featuredPosts !== 'undefined' && Array.isArray(featuredPosts)) ? featuredPosts.slice(1) : [];
        const __shown = new Set((typeof featuredPosts !== 'undefined' && Array.isArray(featuredPosts) ? featuredPosts : []).map(function(fp) { return fp.slug; }));
        const __popular = (typeof popularPosts !== 'undefined' && Array.isArray(popularPosts) ? popularPosts : []).filter(function(p) { return !__shown.has(p.slug); });
    %>
    <% if (__more.length > 0) { %>
    <div class="content-area">
        <div class="featured-posts-grid">
            <% __more.forEach(function(fp) { %>
                <article class="featured-post-card">
                    <h3 class="featured-post-title"<% if (fp.lang && fp.lang !== 'de') { %> lang="<%= fp.lang %>"<% } %>><a href="/blogpost/<%= fp.slug %>" class="featured-post-link"><%= fp.title %></a></h3>
                    <p class="featured-post-excerpt"<% if (fp.lang && fp.lang !== 'de') { %> lang="<%= fp.lang %>"<% } %>><%= fp.excerpt %></p>
                </article>
            <% }); %>
        </div>
    </div>
    <% } %>

    <aside class="sidebar" aria-label="Themen und Archiv">
        <%- include('partials/homeCategories') %>
        <%- include('partials/homeArchive') %>
        <%- include('partials/homePopular', { items: __popular, hideWhenEmpty: true }) %>
    </aside>
</div>
<% } else { %>
<div class="header-section">
    <aside class="sidebar">
        <%- include('partials/homePopular', { items: typeof popularPosts !== 'undefined' ? popularPosts : [], hideWhenEmpty: false }) %>
        <%- include('partials/homeCategories') %>
        <%- include('partials/homeArchive') %>
    </aside>
    <%- include('partials/homeHero') %>
    <div class="content-area">
        <!-- <h3 class="featured-title">Ausgewählte Beiträge</h3> -->
        <div class="featured-posts-grid">
            <% if (typeof featuredPosts !== 'undefined' && Array.isArray(featuredPosts) && featuredPosts.length > 0) { %>
                <% featuredPosts.forEach(function(fp) { %>
                    <article class="featured-post-card">
                        <h4 class="featured-post-title"<% if (fp.lang && fp.lang !== 'de') { %> lang="<%= fp.lang %>"<% } %>><a href="/blogpost/<%= fp.slug %>" class="featured-post-link"><%= fp.title %></a></h4>
                        <p class="featured-post-excerpt"<% if (fp.lang && fp.lang !== 'de') { %> lang="<%= fp.lang %>"<% } %>><%= fp.excerpt %></p>
                        <!-- <div class="featured-post-actions">
                            <% if (fp.previewImage && fp.previewImage.src) { %>
                                <img class="featured-post-preview" src="<%= fp.previewImage.src %>"<% if (fp.previewImage.srcset) { %> srcset="<%= fp.previewImage.srcset %>"<% } %> alt="" loading="lazy" decoding="async" width="72" height="72">
                            <% } %>
                            <a href="/blogpost/<%= fp.slug %>" class="btn btn-outline-primary">Lesen</a>
                        </div> -->
                    </article>
                <% }); %>
            <% } else { %>
                <article class="featured-post-card">
                    <h4 class="featured-post-title"><a href="/blogpost/beyond-the-first-magic-trick" class="featured-post-link">AI Agents</a></h4>
                    <p class="featured-post-excerpt">Beyond the first magic trick: The disillusionment with AI agents.</p>
                    <div class="featured-post-actions">
                        <a href="/blogpost/beyond-the-first-magic-trick" class="btn btn-outline-primary">Lesen</a>
                    </div>
                </article>
                <article class="featured-post-card">
                    <h4 class="featured-post-title"><a href="/blogpost/vom-archiv-zur-ablenkung" class="featured-post-link">Vom Archiv zur Ablenkung</a></h4>
                    <p class="featured-post-excerpt">ein Blick in die Vergangenheit des Internets – als Cookies noch nur etwas zum Essen waren...</p>
                    <div class="featured-post-actions">
                        <a href="/blogpost/vom-archiv-zur-ablenkung" class="btn btn-outline-primary">Lesen</a>
                    </div>
                </article>
                <article class="featured-post-card">
                    <h4 class="featured-post-title"><a href="/blogpost/universitat-wien-wissenschaft-gesinnung" class="featured-post-link">Universität Wien</a></h4>
                    <p class="featured-post-excerpt">Wissenschaft im Dienst der Gesinnung</p>
                    <div class="featured-post-actions">
                        <a href="/blogpost/universitat-wien-wissenschaft-gesinnung" class="btn btn-outline-primary">Lesen</a>
                    </div>
                </article>
            <% } %>
        </div>
    </div>
</div>


<% } %>

<section class="container my-5">
    <!-- <h3 class="featured-title">Fundstücke & Empfehlungen</h3> -->
    <div class="row" id="discoveries-grid">
        <% if (typeof cards !== 'undefined' && Array.isArray(cards) && cards.length > 0) { %>
            <% cards.forEach(function(card, cardIndex) { %>
                <div class="col-md-4 discovery-card-item">
                    <article class="card discovery-card h-100">
                        <% if (card.img_link) { %>
                            <%
                                let imgSrc, imgSrcset;
                                if (card.img_link.startsWith('http')) {
                                    // Extern → keine Varianten
                                    imgSrc = card.img_link;
                                    imgSrcset = null;
                                } else {
                                    const extIndex = card.img_link.lastIndexOf('.');
                                    const base = card.img_link.substring(0, extIndex);
                                    imgSrc = base + '-344.webp';
                                    imgSrcset = base + '-688.webp';
                                }
                            %>
                            <div class="card-img-wrap">
                            <img class="card-img-top"
                                src="<%= imgSrc %>"
                                <% if (imgSrcset) { %>
                                    srcset="<%= imgSrc %> 344w, <%= imgSrcset %> 688w"
                                    sizes="(max-width: 768px) 100vw, 344px"
                                <% } %>
                                width="344"
                                height="310"
                                alt="<%= card.title %>">
                        </div>
                        <% } %>
                        <div class="card-body">
                            <% const __cardHeading = __soft ? 'h3' : 'h5'; %>
                            <<%= __cardHeading %> class="card-title"><%= card.title %></<%= __cardHeading %>>
                            <% if (card.subtitle) { %>
                                <p class="card-text"><%= card.subtitle %></p>
                            <% } %>
                        </div>
                        <div class="card-footer">
                            <a href="<%= card.link %>" class="btn btn-outline-primary" target="_blank" rel="noopener noreferrer">Mehr lesen</a>
                        </div>
                    </article>
                </div>
            <% }); %>
        <% } else { %>
            <div class="col-12 text-muted">Keine Empfehlungen verfuegbar.</div>
        <% } %>
    </div>
    <% if (typeof cardsPagination !== 'undefined' && cardsPagination) { %>
        <%- include('partials/pagination', { pagination: cardsPagination }) %>
    <% } %>
</section>

