<%
    pageTitle = 'Blogpost - Sub specie aeternitatis';
    metaDescription = 'Philosophy, Tech, Science, News and me';
    usePrism = true;
    extraHead = typeof post !== 'undefined' && post && post.id ? `<meta name="post-id" content="${Number(post.id)}">` : '';
    if (typeof post !== 'undefined' && post && post.slug) {
        extraHead += `<link rel="canonical" href="https://speculumx.at/blogpost/${encodeURIComponent(post.slug)}">`;
    }
%>

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="content-area">
                <div id="blogpost-content">
                    <% if (!post) { %>
                    <div id="loading" class="loading-spinner">
                        <div class="spinner"></div>
                        <p>Lade Blogpost...</p>
                    </div>
                    <% } %>

                    <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
                    <p class="text-muted small"><%= errorMessage %></p>
                    <% } else { %>
                    <article id="post-article" class="<%= post ? '' : 'hidden' %>" <% if (typeof post !== 'undefined' && post && post.id) { %> data-post-id="<%= post.id %>" <% } %>>
                        <header class="post-header">
                            <h2 id="title" class="post-title"><%= post ? post.title : '' %></h2>
                            <div id="meta" class="post-meta-info">
                                <% if (post) { %>
                                    <div class="post-date">Erstellt am <%= new Date(post.created_at).toLocaleDateString('de-DE') %> um <%= new Date(post.created_at).toLocaleTimeString('de-DE', { hour: '2-digit', minute: '2-digit' }) %></div>
                                    <% if (post.updated_at && post.updated_at !== post.created_at) { %>
                                        <div class="post-updated">Zuletzt aktualisiert am <%= new Date(post.updated_at).toLocaleDateString('de-DE') %> um <%= new Date(post.updated_at).toLocaleTimeString('de-DE', { hour: '2-digit', minute: '2-digit' }) %></div>
                                    <% } %>
                                    <div class="post-reading-time">Lesezeit: ca. <%= Math.ceil((post.content || '').split(' ').filter(Boolean).length / 200) %> min.</div>
                                <% } %>
                            </div>
                        </header>
                        <div id="content" class="post-content"><% if (post && post.content) { %><%- post.content %><% } %></div>
                        <footer class="post-footer">
                            <div id="tags" class="post-tags-container">
                                <% if (post && Array.isArray(post.tags) && post.tags.length > 0) { %>
                                    <div class="tags-label">Tags:</div>
                                    <div class="tags-list">
                                        <% post.tags.forEach(function(tag) { %>
                                            <a href="/blogpost/tag/<%= encodeURIComponent(tag) %>" class="tag"><%= tag %></a>
                                        <% }); %>
                                    </div>
                                <% } %>
                            </div>
                        </footer>
                    </article>

                    <% if (post) { %>
                        <%- include('partials/comments.ejs') %>
                    <% } %>
                    <% } %>
                </div>
            </div>
        </div>
    </div>

    <nav class="navigation mt-4 mb-5" aria-label="Post-Navigation">
        <a href="/posts" class="btn btn-outline-primary">Alle Blogposts</a>
        <a href="/" class="btn btn-outline-secondary">Zur Startseite</a>
        <a href="/createPost" class="btn btn-outline-success create-link hidden">Neuen Post erstellen</a>
        <% if (typeof isAdmin !== 'undefined' && isAdmin && post && post.id) { %>
        <a href="/blogpost/update/<%= post.id %>" class="btn btn-outline-warning">
            Post bearbeiten
        </a>
        <% } %>
    </nav>
</div>

<% if (typeof post !== 'undefined' && post) { %>
<script id="server-post" type="application/json"<% if (typeof nonce !== 'undefined') { %> nonce="<%= nonce %>"<% } %>><%- (function(obj){ try { var s = JSON.stringify(obj); return s.replace(/</g,'\\u003c').replace(/-->/g,'--\\u003e').replace(/\u2028/g,'\\u2028').replace(/\u2029/g,'\\u2029'); } catch(e){ return 'null'; } })(post) %></script>
<% } %>

<% if (typeof post !== 'undefined' && post && post.id && typeof csrfToken !== 'undefined' && csrfToken) { %>
<script id="view-beacon" data-post-id="<%= Number(post.id) %>" data-csrf="<%= csrfToken %>"<% if (typeof nonce !== 'undefined') { %> nonce="<%= nonce %>"<% } %>>
// Counts a read once per page view, after 5 s of visible time. Crawlers that
// only fetch the HTML never run this, so they no longer show up in `views`.
(function() {
    var el = document.getElementById('view-beacon');
    var postId = el && el.getAttribute('data-post-id');
    var token = el && el.getAttribute('data-csrf');
    if (!postId || !token) return;

    var NEEDED_MS = 5000;
    var visibleMs = 0;
    var visibleSince = null;
    var timer = null;
    var sent = false;

    function send() {
        if (sent) return;
        sent = true;
        document.removeEventListener('visibilitychange', onVisibilityChange);
        var url = '/blogpost/id/' + encodeURIComponent(postId) + '/view';
        var body = new URLSearchParams({ _csrf: token });
        try {
            if (navigator.sendBeacon && navigator.sendBeacon(url, body)) return;
        } catch (_e) { /* fall back to fetch */ }
        try {
            fetch(url, { method: 'POST', body: body, credentials: 'same-origin', keepalive: true }).catch(function() {});
        } catch (_e) { /* counting is best effort */ }
    }

    function start() {
        if (sent || visibleSince !== null) return;
        visibleSince = Date.now();
        timer = setTimeout(send, Math.max(0, NEEDED_MS - visibleMs));
    }

    function pause() {
        if (visibleSince === null) return;
        visibleMs += Date.now() - visibleSince;
        visibleSince = null;
        clearTimeout(timer);
    }

    function onVisibilityChange() {
        if (document.visibilityState === 'visible') start(); else pause();
    }

    document.addEventListener('visibilitychange', onVisibilityChange);
    if (document.visibilityState === 'visible') start();
})();
</script>
<% } %>

<script<% if (typeof nonce !== 'undefined') { %> nonce="<%= nonce %>"<% } %>>
(function() {
    try {
        var serverPostEl = document.getElementById('server-post');
        if (serverPostEl) {
            var loadingEl = document.getElementById('loading');
            if (loadingEl && loadingEl.parentNode) loadingEl.parentNode.removeChild(loadingEl);
            var postArticle = document.getElementById('post-article');
            if (postArticle) {
                postArticle.classList.remove('hidden');
                postArticle.style.display = 'block';
            }
        }
    } catch (err) { console.debug('defensive spinner removal failed', err); }
})();
</script>

<script<% if (typeof nonce !== 'undefined') { %> nonce="<%= nonce %>"<% } %>>
document.querySelectorAll('pre[class*="language-"] > code:not([class*="language-"])').forEach(function(c) {
    var m = c.parentElement.className.match(/language-[\w-]+/);
    if (m) c.classList.add(m[0]);
});
document.querySelectorAll('pre:not([class*="language-"])').forEach(function(p) {
    p.classList.add('language-plaintext');
    var c = p.querySelector('code');
    if (c && !c.className.match(/language-/)) c.classList.add('language-plaintext');
});
</script>

<script src="https://cdn.jsdelivr.net/npm/prismjs@1.29.0/components/prism-core.min.js"<% if (typeof nonce !== 'undefined') { %> nonce="<%= nonce %>"<% } %>></script>
<script src="https://cdn.jsdelivr.net/npm/prismjs@1.29.0/plugins/autoloader/prism-autoloader.min.js"<% if (typeof nonce !== 'undefined') { %> nonce="<%= nonce %>"<% } %>></script>
