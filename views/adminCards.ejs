<%
    pageTitle = 'Cards verwalten - Admin';
    metaDescription = '';
    metaRobots = 'noindex, nofollow';
%>

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="content-area">

                <h2 class="mb-4">Cards verwalten</h2>

                <% if (typeof cards !== 'undefined' && Array.isArray(cards) && cards.length > 0) { %>
                    <div id="cards-admin-list">
                        <% cards.forEach(function(card) { %>
                            <article class="blog-post-card">
                                <div class="post-meta">
                                    <span class="post-date"><%= card.published ? 'Veröffentlicht' : 'Nicht veröffentlicht' %></span>
                                </div>
                                <%
                                    // Local images have the -344 variant that the home page uses; external ones are shown as they are
                                    const __thumb = card.img_link && !card.img_link.startsWith('http')
                                        ? card.img_link.replace(/\.[^./]+$/, '') + '-344.webp'
                                        : card.img_link;
                                    let __host = card.link;
                                    try { __host = new URL(card.link).hostname.replace(/^www\./, ''); } catch (_e) { /* keep the raw link */ }
                                %>
                                <h2 class="post-title">
                                    <span class="post-link"><%= card.title %></span>
                                </h2>
                                <% if (__thumb) { %>
                                    <img src="<%= __thumb %>" alt="" width="172" height="155" loading="lazy" decoding="async" class="img-thumbnail mb-2">
                                <% } %>
                                <% if (card.subtitle) { %>
                                    <p class="text-muted"><%= card.subtitle %></p>
                                <% } %>
                                <p class="text-muted"><a href="<%= card.link %>" target="_blank" rel="noopener noreferrer"><%= __host %></a></p>
                                <div class="post-footer">
                                    <a href="/cards/<%= card.id %>/edit" class="btn btn-sm btn-outline-warning">Bearbeiten</a>
                                </div>
                            </article>
                        <% }); %>
                    </div>
                <% } else { %>
                    <p class="text-muted">Keine Cards vorhanden.</p>
                <% } %>

            </div>
        </div>
    </div>
    <nav class="navigation mt-4 mb-5" aria-label="Seiten-Navigation">
        <a href="/cards/create" class="btn btn-outline-success">Neue Card erstellen</a>
        <a href="/admin" class="btn btn-outline-secondary">Zurück zum Admin-Panel</a>
    </nav>
</div>
