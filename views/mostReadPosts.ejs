<% 
    pageTitle = 'Meistgelesene Posts - Sub specie aeternitatis';
    metaDescription = 'The most read posts on philosophy, tech, science and more.';
    const __itemHeading = (typeof theme !== 'undefined' && theme && theme.id === 'soft') ? 'h2' : 'h3';
%>

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="content-area">
                <h1 class="sr-only">Meistgelesene Beiträge</h1>
                <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
                    <p class="text-muted small"><%= errorMessage %></p>
                <% } %>
                <div id="mostReadPosts">
                    <% if (typeof posts !== 'undefined' && Array.isArray(posts) && posts.length > 0) { %>
                        <% posts.forEach(function(post, idx) { %>
                            <article class="most-read-item">
                                <span class="rank">#<%= idx + 1 %></span>
                                <div class="most-read-content">
                                    <<%= __itemHeading %><% if (post.lang && post.lang !== 'de') { %> lang="<%= post.lang %>"<% } %>><a class="post-link-style" href="/blogpost/<%= post.slug || ('id/' + post.id) %>"><%= post.title %></a></<%= __itemHeading %>>
                                    <p><%= (post.views || 0) %> views | <%= new Date(post.created_at).toLocaleDateString('de-DE') %></p>
                                    <p class="post-excerpt"<% if (post.lang && post.lang !== 'de') { %> lang="<%= post.lang %>"<% } %>><%= post.excerpt %></p>
                                </div>
                            </article>
                        <% }); %>
                    <% } else { %>
                        <div class="loading-spinner">
                            <div class="spinner"></div>
                            <p>Lade Statistiken...</p>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>
    </div>
    <nav class="navigation mt-4 mb-5" aria-label="Seiten-Navigation">
        <a href="/" class="btn btn-outline-primary">Zur Startseite</a>
        <a href="/posts" class="btn btn-outline-secondary">Alle Posts</a>
    </nav>
</div>
