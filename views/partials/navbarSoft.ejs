<% // Navbar of the "soft" theme. Behaviour (menu toggle, live search) lives in /assets/js/themes/soft/navigation.js %>
<% function __safeJson(obj) { try { const s = JSON.stringify(obj); return s.replace(/</g, '\\u003c').replace(/-->/g, '--\\u003e').replace(/\u2028/g, '\\u2028').replace(/\u2029/g, '\\u2029'); } catch (e) { return 'null'; } } %>
<% const __nonceAttr = (typeof nonce !== 'undefined') ? ' nonce="' + String(nonce) + '"' : '' %>
<% const __isAdmin = (typeof isAdmin !== 'undefined') ? !!isAdmin : false; %>
<% const __assetVersion = (typeof assetVersion !== 'undefined') ? String(assetVersion || '') : ''; %>
<%
    const __path = (typeof currentPath === 'string' && currentPath) ? currentPath : '/';
    const __under = (prefix) => __path === prefix || __path.startsWith(prefix + '/');
    // A single post page belongs to "Posts"; most-read and archive are sibling sections.
    const __inPosts = __path === '/posts' || (__under('/blogpost') && !__under('/blogpost/most-read') && !__under('/blogpost/archive'));
    const __items = [
        { href: '/', label: 'Home', current: __path === '/', section: false, mobileOnly: true },
        { href: '/posts', label: 'Posts', current: __path === '/posts', section: __inPosts },
        { href: '/blogpost/most-read', label: 'Meistgelesen', current: __path === '/blogpost/most-read', section: false },
        { href: '/blogpost/archive', label: 'Archiv', current: __path === '/blogpost/archive', section: __under('/blogpost/archive') },
        { href: '/about', label: 'Kontakt', current: __path === '/about', section: false },
    ];
    const __searchValue = (typeof searchQuery === 'string') ? searchQuery : '';
%>
<a class="skip-link" href="#main">Zum Inhalt springen</a>
<header class="site-header">
    <nav class="navbar" aria-label="Hauptnavigation">
        <div class="navbar-container">
            <a class="brand" href="/" aria-label="Sub specie aeternitatis – Startseite">
                <span class="brand-mark" aria-hidden="true"></span>
                <span class="logo">Sub specie aeternitatis</span>
            </a>

            <button class="nav-toggle" id="nav-toggle" type="button" aria-expanded="false" aria-controls="navbar-panel" aria-label="Menü öffnen">
                <span class="nav-toggle-bars" aria-hidden="true"><span></span><span></span><span></span></span>
            </button>

            <div class="navbar-panel" id="navbar-panel">
                <form class="nav-search" id="nav-search-form" role="search" aria-label="Blog durchsuchen" action="/search" method="GET">
                    <label class="sr-only" for="nav-search-input">Blog durchsuchen</label>
                    <button class="nav-search-submit" type="submit" aria-label="Suche starten">
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="6.5"></circle><path d="M16 16l4.5 4.5"></path></svg>
                    </button>
                    <input id="nav-search-input" class="nav-search-input" type="search" name="q" value="<%= __searchValue %>"
                           placeholder="Suchen…" autocomplete="off" maxlength="100" enterkeyhint="search"
                           role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="nav-search-results">
                    <kbd class="nav-search-hint" aria-hidden="true">/</kbd>
                    <ul class="search-suggestions" id="nav-search-results" role="listbox" aria-label="Suchvorschläge" hidden></ul>
                    <div class="sr-only" id="nav-search-status" role="status" aria-live="polite"></div>
                </form>

                <ul class="menu-items" id="navbar-menu-items">
                    <% __items.forEach(function(item) { %>
                    <li<% if (item.mobileOnly) { %> class="menu-home"<% } %>>
                        <a href="<%= item.href %>"<% if (item.current) { %> aria-current="page"<% } else if (item.section) { %> aria-current="true"<% } %><% if (item.current || item.section) { %> class="is-active"<% } %>><%= item.label %></a>
                    </li>
                    <% }); %>
                    <% if (__isAdmin) { %>
                    <li id="admin-nav-link"><a href="/admin"<% if (__under('/admin')) { %> class="is-active" aria-current="page"<% } %>>Admin</a></li>
                    <% } %>
                    <% if (__isAdmin && typeof csrfToken !== 'undefined' && csrfToken) { %>
                    <li>
                        <form id="admin-logout-form" method="POST" action="/auth/logout" class="d-inline">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <button type="submit" class="nav-link-button">Logout</button>
                        </form>
                    </li>
                    <% } %>
                </ul>
            </div>
        </div>
    </nav>
</header>
<script id="server-config" type="application/json"<%- __nonceAttr %>>
    <%- __safeJson({ isAdmin: __isAdmin, assetVersion: __assetVersion }) %>
</script>
